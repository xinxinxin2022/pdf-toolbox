{
  "name": "pdf-toolbox",
  "version": "1.0.0",
  "type": "module",
  "description": "Free online PDF tools - 100% private, no upload required",
  "scripts": {
    "dev": "vite",
    "build": "npx tsx scripts/generate-pages.ts && vite build && npx tsx scripts/post-build.ts",
    "preview": "vite preview",
    "generate-sitemap": "tsx scripts/generate-sitemap.ts",
    "generate-pages": "tsx scripts/generate-pages.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-i18next": "^13.5.0",
    "i18next": "^23.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.379",
    "jszip": "^3.10.1",
    "lucide-react": "^0.294.0",
    "react-helmet-async": "^2.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
